# Copy to .env for local runs. Every value has a default; these are the defaults.

# PostgreSQL (docker compose publishes it on port 5433 to avoid clashing with a local install)
DATABASE_URL=postgresql+psycopg://qissa:qissa@localhost:5433/qissa

# Where uploaded files are stored, under their SHA-256
STORAGE_DIR=data/audio

# Largest accepted upload in MB (120 minutes at 320 kbps is 288 MB)
MAX_UPLOAD_MB=300

# Duration outlier rule
OUTLIER_MIN_SECONDS=30
OUTLIER_MAX_SECONDS=7200
OUTLIER_RATIO=3
OUTLIER_MIN_CHAPTERS=3

LOG_LEVEL=INFO
